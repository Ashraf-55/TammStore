CODELA_ENV=production
CODELA_SECRET_KEY=GENERATE-A-UNIQUE-32-PLUS-CHARACTER-SECRET
CODELA_SECRET_KEY_PREVIOUS=
CODELA_CORS_ORIGINS=https://app.example.com
CODELA_MAX_BODY_BYTES=2097152
CODELA_METRICS_TOKEN=GENERATE-A-SEPARATE-METRICS-TOKEN
DATABASE_URL=postgresql://USER:PASSWORD@DB-HOST:5432/codela

REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
CODELA_PLATFORM_ADMIN_EMAILS=platform-admin@example.com
CODELA_JOB_LEASE_SECONDS=60
CODELA_COOKIE_AUTH=1
# Fernet key for encrypting tenant integration credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CODELA_ENCRYPTION_KEY=GENERATE-A-FERNET-KEY

# Redis authentication
REDIS_PASSWORD=replace-with-a-long-random-secret
# Fernet key for integration credentials
