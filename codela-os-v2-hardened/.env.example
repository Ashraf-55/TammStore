CODELA_ENV=development
CODELA_SECRET_KEY=replace-with-a-random-32-plus-character-secret
CODELA_CORS_ORIGINS=http://localhost:5000
# If you serve the frontend from a separate static server instead of letting
# Flask serve it (see README), add that origin too, e.g.:
# CODELA_CORS_ORIGINS=http://localhost:5000,http://localhost:8080
CODELA_MAX_BODY_BYTES=2097152
CODELA_METRICS_TOKEN=replace-me
