# Copy this file to "keystore.properties" (same folder) and fill in your real values.
# keystore.properties is already in .gitignore — never rename this .example file itself
# to hold real secrets, and never zip/commit/share the real keystore.properties.

storeFile=app/release-key.jks
storePassword=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
keyAlias=tamm-release
keyPassword=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
